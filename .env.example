# Server-only. Never expose this key in client-side code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Reward vault. Use TestAlbatross before creating a separate production vault.
MIMO_VAULT_NETWORK=TestAlbatross
MIMO_VAULT_ADDRESS=
MIMO_VAULT_KEYPAIR_HEX=
NIMIQ_RPC_URL=

# Capped, non-custodial real-NIM pilot. The creator confirms every payout in
# Nimiq Pay and Mimo independently verifies the resulting transaction.
MIMO_MAINNET_PAYOUTS_ENABLED=false
MIMO_MAINNET_RPC_URL=https://rpc.nimiqwatch.com
MIMO_MAINNET_MAX_REWARD_NIM=5

# 32 random bytes, base64 encoded. Encrypts payout and refund addresses at rest.
MIMO_DATA_ENCRYPTION_KEY=

# Durable relational data and public community pictures on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
