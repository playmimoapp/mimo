# Server-only. Never expose this key in client-side code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Reward vault. Mainnet stays fail-closed until every production secret is set.
MIMO_VAULT_NETWORK=MainAlbatross
MIMO_VAULT_ADDRESS=
MIMO_VAULT_KEYPAIR_HEX=
NIMIQ_RPC_URL=
MIMO_VAULT_FEE_PER_BYTE_LUNA=1
MIMO_MAINNET_VAULT_ENABLED=false
MIMO_TESTNET_VAULT_ENABLED=false
MIMO_MAINNET_VAULT_MAX_REWARD_NIM=200
MIMO_MAINNET_VAULT_MAX_PAYOUTS=100

# Capped, non-custodial real-NIM pilot. The creator confirms every payout in
# Nimiq Pay and Mimo independently verifies the resulting transaction.
MIMO_MAINNET_PAYOUTS_ENABLED=false
MIMO_MAINNET_RPC_URL=https://rpc.nimiqwatch.com
MIMO_MAINNET_MAX_REWARD_NIM=200

# 32 random bytes, base64 encoded. Encrypts payout and refund addresses at rest.
MIMO_DATA_ENCRYPTION_KEY=

# Durable relational data and public community pictures on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Public origin and Discord integration. The bot token stays server-only.
MIMO_PUBLIC_URL=http://localhost:3000
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=
